{
  "description": "Load scoped context and checkpoint safe transcript deltas.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/hook.mjs",
              "--state-dir",
              "${CLAUDE_PLUGIN_DATA}"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/hook.mjs",
              "--state-dir",
              "${CLAUDE_PLUGIN_DATA}"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/hook.mjs",
              "--state-dir",
              "${CLAUDE_PLUGIN_DATA}"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "clear|resume|logout|prompt_input_exit|other",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/hook.mjs",
              "--state-dir",
              "${CLAUDE_PLUGIN_DATA}"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
